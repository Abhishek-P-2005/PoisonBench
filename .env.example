# ============================================================================
# Environment Configuration
# ============================================================================
# Copy this file to `.env` and replace the placeholder values with your own.
#
# If you are using Docker Compose, most variables are already provided through
# docker-compose.yml. This file is primarily intended for running the project
# directly on your host machine, such as local development or utility scripts.
# ============================================================================


# ============================================================================
# ChromaDB Configuration
# ============================================================================
# Hostname or IP address of the ChromaDB server.
CHROMA_HOST=<your_chroma_host>

# Port used by the ChromaDB server.
CHROMA_PORT=<your_chroma_port>


# ============================================================================
# PostgreSQL Configuration
# ============================================================================
# Database server hostname.
POSTGRES_HOST=<your_postgres_host>

# Database server port.
POSTGRES_PORT=<your_postgres_port>

# Database name.
POSTGRES_DB=<your_database_name>

# Database username.
POSTGRES_USER=<your_database_user>

# Database password.
POSTGRES_PASSWORD=<your_database_password>


# ============================================================================
# Redis Configuration
# ============================================================================
# Redis server hostname.
REDIS_HOST=<your_redis_host>

# Redis server port.
REDIS_PORT=<your_redis_port>


# ============================================================================
# Ollama Configuration
# ============================================================================
# Hostname where the Ollama server is running.
OLLAMA_HOST=<your_ollama_host>

# Ollama API port.
OLLAMA_PORT=<your_ollama_port>

# Name of the Ollama model to use.
# Example: phi3:mini, llama3.2:3b, mistral
OLLAMA_MODEL=<your_model_name>


# ============================================================================
# Embedding Model
# ============================================================================
# Sentence Transformer model used to generate document embeddings.
# Example: all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=<your_embedding_model>


# ============================================================================
# NVD API Configuration (Optional)
# ============================================================================
# National Vulnerability Database API key.
# Leaving this empty is supported, but providing a key increases
# the request rate limit for vulnerability lookups.
#
# Request a free API key:
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=<your_nvd_api_key>